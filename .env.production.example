# DCFT production environment template.
# Do not commit real values. Store secrets in the cloud provider secret manager.

DCFT_APP_NAME=dcft-backend
DCFT_APP_VERSION=0.1.0
DCFT_APP_ENV=production
DCFT_DEBUG=false
DCFT_LOG_LEVEL=INFO

DCFT_ADMIN_USERNAME=dcft_admin
DCFT_ADMIN_PASSWORD=<set-in-secret-manager-min-14-chars>
DCFT_JWT_SECRET=<set-in-secret-manager-min-32-chars>
DCFT_CREDENTIAL_ENCRYPTION_KEY=<set-in-secret-manager-fernet-key>
DCFT_JWT_PREVIOUS_SECRET=
DCFT_JWT_ALGORITHM=HS256
DCFT_JWT_EXP_MINUTES=60

DCFT_FRONTEND_ORIGIN=https://<production-frontend-domain>
DCFT_CORS_ORIGINS=https://<production-frontend-domain>
APP_PUBLIC_URL=https://<production-frontend-domain>

DCFT_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
DCFT_DATABASE_SSL=true
DCFT_DATABASE_POOL_SIZE=10
DCFT_DATABASE_MAX_OVERFLOW=20
DCFT_DATABASE_POOL_TIMEOUT=30
DCFT_DB_AUTO_MIGRATE=false

DCFT_OBSERVABILITY_PERSIST_CONCURRENCY=20
AI_PROVIDER=openrouter
AI_MODEL=
AI_DEFAULT_MODEL=<optional-default-model>
OPENROUTER_API_KEY=<set-in-secret-manager>
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional hard override. Set false only when CEO/CTO want Doctor disabled even with key.
DCFT_AI_PROVIDER_ENABLED=
DCFT_AI_PROVIDER=openrouter
DCFT_AI_MODEL=
DCFT_AI_REQUEST_TIMEOUT_SECONDS=20
DCFT_OPENROUTER_API_KEY=<optional-dcft-specific-secret>
DCFT_OPENROUTER_MODEL=openai/gpt-4o-mini
DCFT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DCFT_OPENAI_API_KEY=<optional-set-in-secret-manager>
DCFT_OPENAI_MODEL=gpt-4o-mini
DCFT_ANTHROPIC_API_KEY=<optional-set-in-secret-manager>
DCFT_ANTHROPIC_MODEL=claude-sonnet-4-5
DCFT_GEMINI_API_KEY=<optional-set-in-secret-manager>
DCFT_GEMINI_MODEL=gemini-2.5-flash
DCFT_OCR_ENABLED=false

# Email verification. Official target: resend. Fallback: smtp.
EMAIL_PROVIDER=<resend-or-smtp>
EMAIL_FROM=<verified-sender>
EMAIL_API_KEY=<set-in-secret-manager-if-provider-uses-api-key>
SMTP_HOST=<smtp-host-if-smtp>
SMTP_PORT=587
SMTP_USER=<set-in-secret-manager-if-smtp>
SMTP_PASSWORD=<set-in-secret-manager-if-smtp>

# Real checkout. Supported provider: stripe.
PAYMENT_PROVIDER=<stripe>
PAYMENT_PUBLIC_KEY=<set-in-secret-manager>
PAYMENT_SECRET_KEY=<set-in-secret-manager>
PAYMENT_WEBHOOK_SECRET=<set-in-secret-manager>

VITE_DCFT_API_URL=https://<production-backend-domain>
