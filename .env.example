# DCFT local environment template. Copy to .env for local use.
# Do not commit real secrets.

DCFT_APP_NAME=dcft-backend
DCFT_APP_VERSION=0.1.0
DCFT_APP_ENV=local
DCFT_DEBUG=true
DCFT_LOG_LEVEL=INFO

DCFT_ADMIN_USERNAME=dcft_admin
DCFT_ADMIN_PASSWORD=change-this-local-bootstrap-password
DCFT_JWT_SECRET=change-this-local-jwt-secret-at-least-32-chars
DCFT_JWT_ALGORITHM=HS256
DCFT_JWT_EXP_MINUTES=60

DCFT_FRONTEND_ORIGIN=http://localhost:5174
DCFT_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# PostgreSQL-ready URL for future cloud/staging.
# Local default falls back to SQLite when this is empty.
DCFT_DATABASE_URL=
DCFT_DATABASE_SSL=false
DCFT_DB_AUTO_MIGRATE=false

DCFT_AI_PROVIDER_ENABLED=false
DCFT_OCR_ENABLED=false