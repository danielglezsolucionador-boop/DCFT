# DCFT local environment template. Copy to .env for local use.
# Do not commit real secrets.

DCFT_APP_NAME=dcft-backend
DCFT_APP_VERSION=0.1.0
DCFT_APP_ENV=local
DCFT_DEBUG=true
DCFT_LOG_LEVEL=INFO

DCFT_ADMIN_USERNAME=dcft_admin
DCFT_ADMIN_PASSWORD=
DCFT_JWT_SECRET=
DCFT_CREDENTIAL_ENCRYPTION_KEY=
DCFT_JWT_ALGORITHM=HS256
DCFT_JWT_EXP_MINUTES=60

DCFT_FRONTEND_ORIGIN=http://localhost:5174
DCFT_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
APP_PUBLIC_URL=http://localhost:5174

# PostgreSQL-ready URL for future cloud/staging.
# Local default falls back to SQLite when this is empty.
DCFT_DATABASE_URL=
DCFT_DATABASE_SSL=false
DCFT_DB_AUTO_MIGRATE=false

AI_PROVIDER=openrouter
AI_MODEL=
AI_DEFAULT_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional hard override. Leave empty to auto-enable only when the provider key exists.
DCFT_AI_PROVIDER_ENABLED=
DCFT_AI_PROVIDER=openrouter
DCFT_AI_MODEL=
DCFT_AI_REQUEST_TIMEOUT_SECONDS=20
DCFT_OPENROUTER_API_KEY=
DCFT_OPENROUTER_MODEL=openai/gpt-4o-mini
DCFT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DCFT_OPENAI_API_KEY=
DCFT_OPENAI_MODEL=gpt-4o-mini
DCFT_ANTHROPIC_API_KEY=
DCFT_ANTHROPIC_MODEL=claude-sonnet-4-5
DCFT_GEMINI_API_KEY=
DCFT_GEMINI_MODEL=gemini-2.5-flash
DCFT_OCR_ENABLED=false

# Email verification. Leave empty to block activation honestly.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Real checkout. Leave empty to block checkout honestly.
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
